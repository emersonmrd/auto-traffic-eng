# =============================================================
# AUTO TRAFFIC ENGINEERING - CONFIGURAÇÃO DE AMBIENTE (EXEMPLO)
# Copie este arquivo para .env e preencha com seus dados reais
# =============================================================

# Token do Bot gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=seu_token_aqui

# IDs numéricos do Telegram autorizados (separados por vírgula)
# Obtenha seu ID enviando uma mensagem para o bot @userinfobot
# Deixe 0 apenas em ambiente de desenvolvimento aberto
ALLOWED_TELEGRAM_IDS=0

# Configurações do Roteador de Borda
ROUTER_HOST=172.28.100.5
ROUTER_USER=admin
ROUTER_PASSWORD=admin
